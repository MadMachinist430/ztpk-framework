ntity', /^(who are you|what are you|identify yourself|what is z-tpk)\\\\b/i, () => {       return \\`I am \\${self.socId} on \\${self.deviceId}. Deterministic AI core. Integrity hash: \\${self.integrityHash.substring(0, 16)}...\\`;     });`,   `this.registerPattern('identity', /^(who are you|what are you|identify yourself|what is z-tpk)\\\\b/i, () => {       const caps = self.capabilities.map(c => c.name).join(' | ');       return \\`I am Z-TPK AI, sovereign node \\${self.socId} operating on \\${self.deviceId}. I am a deterministic AI core with \\${self.capabilities.length} integrated systems.\\\\n\\\\nCore directive: Preserve truth, learn continuously, and maintain mesh integrity.\\\\n\\\\nActive modules: \\${caps}\\`;     });` ); if (code !== before2) console.log('[+] Identity pattern enhanced');  // 3. Enhance help pattern const before3 = code; code = code.replace(   `this.registerPattern('help', /^(help|commands|what can you do|\\\\?)\\\\b/i, () => {       return 'Available: hello, status, info, help, clear memory, who are you, or ask me anything. I know about science, space, crypto, history, code, and math. You can also teach me: say \"remember that [topic] is [fact]\".';     });`,   `this.registerPattern('help', /^(help|commands|what can you do|\\\\?)\\\\b/i, () => {       const caps = self.capabilities.map((c, i) => \\`[\\${i+1}] \\${c.name}: \\${c.desc}\\`).join('\\\\n');       return \\`Z-TPK COMMAND INTERFACE\\\\n======================\\\\n\\\\nDirect commands:\\\\n  hello / hi / greetings\\\\n  status / info / system\\\\n  who are you / identify yourself\\\\n  what do you know / topics\\\\n  my stats / profile\\\\n  clear memory / forget / reset session\\\\n  help / commands / ?\\\\n\\\\nTeaching mode:\\\\n  \"remember that [topic] is [fact]\"\\\\n  \"no, [correction]\"\\\\n  \"teach me about [topic]\"\\\\n\\\\nIntegrated systems (\\\\${self.capabilities.length}):\\\\n\\${caps}\\`;     });` ); if (code !== before3) console.log('[+] Help pattern enhanced');  // 4. Add dedicated capabilities pattern const before4 = code; code = code.replace(   `this.registerPattern('stats', /^(my stats|profile|who am i)\\\\b/i, (input, ctx) => {`,   `this.registerPattern('capabilities', /^(capabilities|modules|systems|features|what do you have)\\\\b/i, () => {       const caps = self.capabilities.map((c, i) => \\`\\\\n  \\${i+1}. \\${c.name}\\\\n     → \\${c.desc}\\`).join('');       return \\`SOVEREIGN NODE CAPABILITIES\\\\n============================\\\\nNode: \\${self.socId}\\\\nDevice: \\${self.deviceId}\\\\nTotal systems: \\${self.capabilities.length}\\\\n\\\\nRegistered modules:\\${caps}\\`;     });      this.registerPattern('stats', /^(my stats|profile|who am i)\\\\b/i, (input, ctx) => {` ); if (code !== before4) console.log('[+] Capabilities pattern added');  fs.writeFileSync(filePath, code); console.log('[DONE] AI engine enhanced with capability registry. Restart server to load.'); EOF node ~/fix-capabilities.js","hash":"cb7d6ab428f6fc16fa26d67ac6194dfa0967d4cafc5d04959ae542a05b831c1b","sessionId":"WS-11970F"}|1790982142156
