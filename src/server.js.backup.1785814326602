const wss = new WebSocket.Server({ server });

wss.on('connection', (ws, req) => {
  const clientIp = req.socket.remoteAddress;
  const clientId = req.headers['x-device-id'] || 'WS-' + crypto.randomBytes(3).toString('hex').toUpperCase();
  console.log('[WS] Client connected:', clientId);
  ws.isAlive = true;
  ws.on('pong', () => { ws.isAlive = true; });
  ws.on('error', (err) => { console.log('[WS] Client error:', clientId, err.message); });

  ws.send(JSON.stringify({
    text: 'Sovereign link established.',
    sender: 'SYSTEM',
    source: 'system',
    integrityHash: cryptoVault.hash('WELCOME', PASSPHRASE)
  }));

  ws.on('message', async (message) => {
    try {
      const data = JSON.parse(message);
      const userText = data.text || '';
      const senderId = data.sender || clientId;
      const doResearch = data.research !== false;

      ledger.addEntry({ type: 'chat', text: userText, sender: senderId, transport: 'websocket' });
      if (learning) learning.record(clientId, 'user', userText);

      const aiResult = ai.generateResponse(userText, { sessionId: clientId });
      ledger.addEntry({ type: 'ai_response', input: userText, response: aiResult.text, hash: aiResult.integrityHash, sessionId: clientId });

      const responseMsg = {
        text: userText,
        sender: senderId,
        aiResponse: aiResult.text,
        source: 'local',
        integrityHash: aiResult.integrityHash,
        timestamp: aiResult.timestamp
      };
      messageHistory.push(responseMsg);
      if (messageHistory.length > MAX_HISTORY) messageHistory.shift();
      broadcastWS(responseMsg);

      // AUTO-RESEARCH: If AI had no knowledge and research is enabled
      if (doResearch && aiResult.source === 'adaptive') {
        const typingId = 'typing-' + Date.now();
        ws.send(JSON.stringify({ source: 'typing', id: typingId }));
        
        try {
          const research = await scraper.research(userText);
          if (research.confidence === 'high') {
            const researchMsg = {
              text: userText,
              sender: 'SYSTEM',
              aiResponse: '[RESEARCH: ' + research.topic + '] ' + research.answer + ' (Source: ' + research.url + ')',
              source: 'research',
              integrityHash: cryptoVault.hash(research.answer, PASSPHRASE),
              timestamp: new Date().toISOString()
            };
            broadcastWS(researchMsg);
            ledger.addEntry({ type: 'research', query: userText, result: research.answer, source: research.source });
          }
        } catch (err) {
          console.error('[RESEARCH] Failed:', err.message);
        }
      }

      network.gossip({
        text: userText,
        aiResponse: aiResult.text,
        integrityHash: aiResult.integrityHash,
        origin: DEVICE_ID,
        timestamp: Date.now()
      });
    } catch (err) {
      console.error('[WS] Error:', err.message);
      ws.send(JSON.stringify({ text: 'Error processing message.', source: 'system' }));
    }
  });

  ws.on('close', () => {
    console.log('[WS] Client disconnected:', clientId);
  });
});

const pingInterval = setInterval(() => {
  wss.clients.forEach((ws) => {
    if (ws.isAlive === false) return ws.terminate();
    ws.isAlive = false;
    ws.ping();
  });
}, 30000);

